{
    "openapi": "3.0.3",
    "info": {
        "title": "API de reservations",
        "version": "1.0.0",
        "description": "Enregistrement des demandes de reservation du restaurant. Une creation laisse la demande en attente : aucune table n'est confirmee et aucun email n'est envoye. Les essais enregistrent de vraies demandes dans la base du serveur selectionne."
    },
    "servers": [
        { "url": "/", "description": "Backend courant" }
    ],
    "tags": [
        { "name": "Reservations", "description": "Demandes de reservation publiques, sans authentification." }
    ],
    "paths": {
        "/api/reservations": {
            "post": {
                "tags": ["Reservations"],
                "summary": "Envoyer une demande de reservation",
                "operationId": "storeReservation",
                "description": "La date et l'heure locales doivent etre dans le futur, dans le fuseau du restaurant (Europe/Paris par defaut). Les heures inexistantes lors du changement d'heure sont refusees. Limite : 5 tentatives par minute et par adresse IP, y compris les demandes invalides. Le statut est impose a pending par le serveur. Il n'y a pas encore de controle de disponibilite ni de deduplication des envois.",
                "security": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/ReservationRequest" },
                            "example": {
                                "name": "Ada Lovelace",
                                "email": "ada@example.com",
                                "phone": "+33123456789",
                                "date": "2027-10-15",
                                "time": "19:30",
                                "guests": 2
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Demande enregistree, en attente de confirmation.",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ReservationCreated" },
                                "example": {
                                    "id": 1,
                                    "status": "pending",
                                    "message": "Votre demande de reservation a ete recue et reste en attente de confirmation."
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Champs invalides : aucune demande n'est enregistree.",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ValidationError" },
                                "example": {
                                    "message": "Le champ email doit etre une adresse email valide.",
                                    "errors": { "email": ["Le champ email doit etre une adresse email valide."] }
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Trop de tentatives. Attendre le delai Retry-After avant de reessayer.",
                        "headers": {
                            "Retry-After": {
                                "description": "Delai d'attente en secondes.",
                                "schema": { "type": "integer", "minimum": 1 }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ApiError" },
                                "example": { "message": "Too Many Attempts." }
                            }
                        }
                    },
                    "500": {
                        "description": "Erreur interne. Une reponse perdue ou une erreur ne garantit pas que la demande n'a pas ete enregistree ; ne pas renvoyer automatiquement la demande.",
                        "content": {
                            "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ReservationRequest": {
                "type": "object",
                "required": ["name", "email", "phone", "date", "time", "guests"],
                "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Nom du client, non vide apres suppression des espaces en debut et fin." },
                    "email": { "type": "string", "format": "email", "maxLength": 254 },
                    "phone": { "type": "string", "minLength": 6, "maxLength": 32 },
                    "date": { "type": "string", "format": "date", "description": "Date locale YYYY-MM-DD, passee refusee. Choisir une date future lors des essais." },
                    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "example": "19:30", "description": "Heure locale HH:mm, sans secondes. La combinaison date/heure doit etre future." },
                    "guests": { "type": "integer", "minimum": 1, "maximum": 10 }
                }
            },
            "ReservationCreated": {
                "type": "object",
                "required": ["id", "status", "message"],
                "properties": {
                    "id": { "type": "integer", "format": "int64", "minimum": 1 },
                    "status": { "type": "string", "enum": ["pending"] },
                    "message": { "type": "string" }
                }
            },
            "ValidationError": {
                "type": "object",
                "required": ["message", "errors"],
                "properties": {
                    "message": { "type": "string" },
                    "errors": {
                        "type": "object",
                        "additionalProperties": { "type": "array", "items": { "type": "string" } }
                    }
                }
            },
            "ApiError": {
                "type": "object",
                "required": ["message"],
                "properties": { "message": { "type": "string" } }
            }
        }
    }
}